		regulator-suspend-microvolt = <850000>;
	};
};


&pinctrl {

	csi {
		cam3_pwr: cam3-pwr {
			rockchip,pins =
				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;	/* CAM3_PWREN */
		};

		cam4_pwr: cam4-pwr {
			rockchip,pins =
				<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;	/* CAM4_PWR_EN */
		};
	};
	dp {
		dp0_tx1_hpd: dp0-hpd {
			rockchip,pins =
				<2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	exp {
		exp_pins: exp-pins {
			rockchip,pins =
				<1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;	/* GPIO_EXP_INT */
				// <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;	/* GPIO_EXP_RESET */
		};
	};

	mux {
		mux_pins: mux-pins {
			rockchip,pins =
				<1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;		/* CAM_I2C_MUX_RST */
		};
	};

	pcie {
		pcie20_0_vcc_pins: pcie20-0-vcc-pins {
			rockchip,pins =
				<1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIE30_PWREN */
		};

		pcie20_1_vcc_pins: pcie20-1-vcc-pins {
			rockchip,pins =
				<1 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIE30_PWREN */
		};

		pcie20x1_pins: pcie20x1-pins {
			rockchip,pins =
				/* pcie30x1_0_clkreqn_m2 */
				<1 RK_PB5 4 &pcfg_pull_none>,
				/* pcie30x1_0_perstn_m2 */
				<1 RK_PB4 4 &pcfg_pull_none>,
				/* pcie30x1_0_waken_m2 */
				<1 RK_PB3 4 &pcfg_pull_none>;
		};

		pcie30_clk_pins: pcie30-clk-pins {
			rockchip,pins =
				<4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIE30_CLK_PWREN */
		};

		pcie3x4_pins: pci3x4-pins {
			rockchip,pins =
				<1 RK_PB0 4 &pcfg_pull_none>,			/* pcie30x4_clkreqn_m3 */
				<1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>,	/* pcie30x4_perstn_m3 */
				<1 RK_PB1 4 &pcfg_pull_none>;			/* pcie30x4_waken_m3 */
		};
	};
};